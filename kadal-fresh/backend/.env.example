PORT=4000
NODE_ENV=production

# Use a strong random secret in production. Do not leave this as the example value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Initial admin credentials. The first login is forced to change the password.
SEED_ADMIN_USERNAME=Selva
SEED_ADMIN_PASSWORD=KadalFresh2026!Strong

# Development-only OTP fallback. In production this must be false and a real SMS provider must be connected.
DEV_OTP_EXPOSE=false
OTP_TTL_MS=300000

# Persistent storage for SQLite and uploads.
DATABASE_PATH=/data/kadalfresh.db
UPLOAD_DIR=/data/uploads

# Required in production: HTTPS webhook receiving { phone, otp, message }.
# The bearer token is sent as Authorization; keep both values private.
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=

# In production set this to your exact public frontend origin, e.g. https://www.your-domain.com
CORS_ORIGIN=
